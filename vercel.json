{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=/api/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/index?__path=/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
